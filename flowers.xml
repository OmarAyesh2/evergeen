```python
import re

data = []
for idx, it in enumerate(items):
    name_el = it.xpath('.//div[contains(@class, "item-name")]/div[contains(@class, "f-15")]')
    name = name_el[0].text_content().strip() if name_el else ""
    
    img_el = it.xpath('.//img')
    img_src = img_el[0].get('src', '') if img_el else ""
    # Clean image url: sometimes there are HTML entities like &amp;
    img_src = img_src.replace('&amp;', '&')
    
    # Old price
    old_price_el = it.xpath('.//*[@data-testid="old-price"]')
    if old_price_el:
        # Extract currency number
        c_el = old_price_el[0].xpath('.//span[contains(@class, "currency ") or @class="currency"]')
        if c_el:
            old_price_val = c_el[0].text_content().strip()
        else:
            old_price_val = old_price_el[0].text_content().replace('JOD', '').strip()
    else:
        old_price_val = None
        
    # Current / final price
    # The price container has old price (if any) and current price
    price_div = it.xpath('.//div[contains(@class, "price")]')
    curr_price_val = None
    if price_div:
        # Find all div.mb-m-1 inside price_div not inside old-price
        curr_spans = price_div[0].xpath('.//div[not(@data-testid="old-price")]//span[contains(@class, "currency ") or @class="currency"]')
        if curr_spans:
            curr_price_val = curr_spans[-1].text_content().strip()
        else:
            # fallback
            all_curr = price_div[0].xpath('.//span[contains(@class, "currency ") or @class="currency"]')
            if all_curr:
                curr_price_val = all_curr[-1].text_content().strip()

    data.append({
        'index': idx,
        'name': name,
        'old_price_raw': old_price_val,
        'curr_price_raw': curr_price_val,
        'img': img_src
    })

import pandas as pd
df = pd.DataFrame(data)
print(f"Total items parsed: {len(df)}")
print(f"Items with old_price: {df['old_price_raw'].notna().sum()}")
print(f"Items without old_price: {df['old_price_raw'].isna().sum()}")
print("\nItems without old_price sample:")
print(df[df['old_price_raw'].isna()][['name', 'curr_price_raw', 'img']].head())


